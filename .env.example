# 설정 페이지(/admin) 로그인 아이디 / 비밀번호
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# (선택) 로그인 쿠키 서명용 비밀값. 비워두면 ADMIN_PASSWORD 를 사용합니다
ADMIN_SESSION_SECRET=

# Vercel Marketplace 에서 Neon 연결 시 자동으로 들어옵니다. 없으면 .data/site.json 에 저장 (로컬 전용)
DATABASE_URL=
# Vercel Blob 연결 시 자동으로 들어옵니다. 없으면 public/uploads 에 저장 (로컬 전용)
BLOB_READ_WRITE_TOKEN=
